# Yesmine xodimlar paneli — muhit sozlamalari
#
# Bu faylni ".env" deb nusxalang va qiymatlarni to'ldiring.
# ".env" hech qachon git'ga tushmaydi.
#
# Ikkala qiymat ham Supabase Dashboard → Project Settings → API da turadi.
# Publishable (anon) kalit ochiq kalit — u brauzerga baribir chiqadi va
# o'zi hech narsaga ruxsat bermaydi: kim nimani ko'rishini bazadagi
# xavfsizlik qoidalari hal qiladi.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
